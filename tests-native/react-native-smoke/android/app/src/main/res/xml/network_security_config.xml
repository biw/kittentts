<?xml version="1.0" encoding="utf-8"?>
<!--
  The smoke test serves pinned fixtures from the CI host over plain HTTP.
  Allow cleartext only for the emulator host alias and loopback so the
  Release build can reach it; every other origin keeps the platform default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
